# .env.prod
NODE_ENV=prod
PORT=8080
JWT_SECRET=prod_secret_xxxx

# Redis（RATE_LIMIT_STORE=redis 时生效）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=rl:

# MySQL 连接池
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=koa_init
DB_POOL_SIZE=20
DB_QUEUE_LIMIT=100

# 文件上传下载
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=20971520
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,application/pdf

# 滑动窗口限流：多实例部署请用 redis
RATE_LIMIT_STORE=redis
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_MS=60000
