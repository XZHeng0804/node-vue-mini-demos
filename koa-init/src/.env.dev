# .env.dev
NODE_ENV=dev
PORT=3000
JWT_SECRET=dev_secret_123

# Redis（RATE_LIMIT_STORE=redis 时生效）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=rl:

# MySQL 连接池
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=koa_init
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=0

# 文件上传下载
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_FILES=10
# 允许的 MIME 类型，逗号分隔，留空不限制
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,application/pdf

# 滑动窗口限流：memory 单实例内存 / redis
RATE_LIMIT_STORE=memory
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_MS=60000
